{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Kairion": {
    "UseHangfire": false,
    "ConnectionString": null,
    "Providers": {
      "Source": {
        "manual": { "DisplayName": "Manual URL import" },
        "demo-search": { "DisplayName": "Demo search (offline, synthetic)" }
      },
      "Ai": {
        "deterministic-demo": { "DisplayName": "Deterministic demo (offline)" }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
