# Kairion environment variables (sample).
#
# Copy to `.env`, fill in values, and export them before `dotnet run`
# (for example: `set -a; . ./.env; set +a`). Production deployments must use
# a real secret manager; never commit filled values.

# Self-hosting mode and bind address.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5288

# PostgreSQL connection string. Leave empty to use the in-memory fallback
# (tests and offline demos only — data is not persisted across restarts).
Kairion__ConnectionString=

# Password used by docker-compose.yml for the local PostgreSQL container.
# Required before `docker compose up`; no credential is stored in the compose file.
KAIRION_DB_PASSWORD=

# Set to "true" to enable Hangfire + PostgreSQL for background jobs. When
# false, the in-process scheduler handles enqueue calls without a worker,
# which is the default for a single-node self-hosted deployment.
Kairion__UseHangfire=false

# BYOK AI provider secrets (placeholders only; supply real values through the
# secret manager, never through this file).
# Kairion__Ai__OpenAi__ApiKey=replace-me
# Kairion__Ai__Anthropic__ApiKey=replace-me
